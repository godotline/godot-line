#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

plugin_cfg="addons/template/plugin.cfg"
plugin_script="addons/template/plugin.gd"

# pre-commit runs before the new commit exists, so use the next reachable
# commit count for a normal commit. The count is independent of file content.
if current_count="$(git rev-list --count HEAD 2>/dev/null)"; then

    commit_count=$((current_count + 1))
else
    commit_count=1
fi

version="2.3.${commit_count}"

if [[ ! -f "$plugin_cfg" || ! -f "$plugin_script" ]]; then
    printf 'pre-commit: required plugin files are missing\n' >&2
    exit 1
fi

if ! grep -qE '^version="[^"]*"$' "$plugin_cfg"; then
    printf 'pre-commit: could not find plugin version in %s\n' "$plugin_cfg" >&2
    exit 1
fi

if ! grep -qE '^[[:space:]]*_menu_button\.text = "模板 [^"]*"$' "$plugin_script"; then
    printf 'pre-commit: could not find template menu version in %s\n' "$plugin_script" >&2
    exit 1
fi

sed -i -E "s/^version=\"[^\"]*\"$/version=\"${version}\"/" "$plugin_cfg"
sed -i -E "s/^([[:space:]]*_menu_button\.text = \"模板 )[^\"]*(\")$/\1${version}\2/" "$plugin_script"

# The generated version must be part of the commit being created.
git add -- "$plugin_cfg" "$plugin_script"

printf 'pre-commit: template version set to %s\n' "$version"
